{
  "destructive-command-review": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/pre_command_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sensitive-file-review": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/sensitive_file_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "documentation-post-write-check": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/post_doc_write_check.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "model-post-write-check": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/post_model_write_check.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "stop-readiness-check": {
    "enabled": false,
    "Stop": [
      {
        "type": "command",
        "command": "python tools/hooks/stop_readiness_check.py",
        "timeout": 10
      }
    ]
  }
}
