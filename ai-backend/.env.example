# Core Backend Environment Variables
APP_ENV=development
APP_NAME=ai-chan-backend
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security & Auth
SECRET_KEY=change-this-in-production-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_chan_db
# For SQLite local dev:
# DATABASE_URL=sqlite+aiosqlite:///./ai_chan.db

# Redis / Cache
REDIS_URL=redis://localhost:6379/0

# LLM Provider API Keys (Managed by ai-backend/llm)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LLM Fallback & Limits
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite
MAX_TOKENS_PER_REQUEST=4096
TOKEN_BUDGET_DAILY_USD=10.0

# Discord OAuth2 Settings (ADR-007)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback
DISCORD_PUBLIC_KEY=

# AI-Chan Integrated Discord Bot Runtime
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=
DISCORD_BOT_API_BASE_URL=http://localhost:8000
DISCORD_BOT_API_KEY=
DISCORD_BOT_TIMEOUT_SECONDS=30.0

# ==============================================================================
# Development Orchestrator & Agent Runner Configuration (ADR-015)
# ==============================================================================
ORCHESTRATOR_ENABLED=true
MAX_PARALLEL_TASKS_PER_WORKSPACE=1

# Local Agent Runner Settings (configured via pairing or runner.json)
# RUNNER_ALLOWED_WORKSPACE_ROOTS=C:\Users,D:\Projects
# AGY_EXECUTABLE_PATH=C:\Users\PC\AppData\Local\agy\bin\agy.exe
# AGY_TIMEOUT_SECONDS=300
# AGY_SANDBOX_ENABLED=true

