%% ------------------------------------------------------------------------------
%% DIAGRAM 1: Git Worktree Lifecycle & Isolation State Machine
%% ------------------------------------------------------------------------------
stateDiagram-v2
    [*] --> PRE_FLIGHT_CHECK : Task Dispatched to Runner

    state PRE_FLIGHT_CHECK {
        [*] --> INSPECT_MAIN_REPO : Validate Repo Root
        INSPECT_MAIN_REPO --> CHECK_DIRTY_FILES : git status --porcelain
        CHECK_DIRTY_FILES --> DIRTY_PRESERVED : Uncommitted Host Changes Detected
        CHECK_DIRTY_FILES --> CLEAN_HOST : Host Tree Clean
        DIRTY_PRESERVED --> BRANCH_HEAD : Safe Strategy (Branch from HEAD)
        CLEAN_HOST --> BRANCH_HEAD : Branch from HEAD
    }

    PRE_FLIGHT_CHECK --> CREATE_WORKTREE : Safe Canonical Path Validated
    PRE_FLIGHT_CHECK --> REJECT_COLLISION : Path Injection / Collision Detected

    state CREATE_WORKTREE {
        [*] --> GENERATE_BRANCH_NAME : ai-chan/task-{id[:8]}-att{N}
        GENERATE_BRANCH_NAME --> RESOLVE_PATH : .ai-chan/worktrees/{attempt_id}
        RESOLVE_PATH --> GIT_WORKTREE_ADD : git worktree add -b <branch> <path> HEAD
    }

    CREATE_WORKTREE --> AGENT_EXECUTION : Worktree Ready (is_isolated=1)

    state AGENT_EXECUTION {
        [*] --> RUN_SUBPROCESS : Execution in Isolated Directory
        RUN_SUBPROCESS --> COLLECT_DIFF : git diff HEAD
        COLLECT_DIFF --> APPLY_SECURITY_MASK : Mask Secrets & Cap at 500KB
        APPLY_SECURITY_MASK --> PIPELINE_VERIFICATION : Run Verification Steps
    }

    AGENT_EXECUTION --> AWAITING_REVIEW : Diff & Verifications Reported

    state AWAITING_REVIEW {
        [*] --> REVIEW_GATE : Pending Human Review
        REVIEW_GATE --> APPROVED : User Approves
        REVIEW_GATE --> CHANGES_REQUESTED : User Requests Changes
        REVIEW_GATE --> REJECTED : User Rejects
    }

    AWAITING_REVIEW --> SAFE_CLEANUP : On Task Completion / Explicit Purge
    AWAITING_REVIEW --> PRESERVE_WORKTREE : On Changes Requested (Keep Worktree History)

    state SAFE_CLEANUP {
        [*] --> CHECK_WORKTREE_DIRTY : Check Uncommitted Changes
        CHECK_WORKTREE_DIRTY --> REFUSE_DELETE : Uncommitted Edits Present (Do Not Delete)
        CHECK_WORKTREE_DIRTY --> GIT_WORKTREE_REMOVE : Clean (git worktree remove --force)
    }

    SAFE_CLEANUP --> [*]
    PRESERVE_WORKTREE --> [*]
    REJECT_COLLISION --> [*]
