%% DIAGRAM 7: Network Connectivity & Trust Boundaries
%% ------------------------------------------------------------------------------
flowchart LR
    subgraph PublicBoundary ["Zone 1: Developer Browser (Untrusted WAN/LAN)"]
        Browser["User Browser"]
    end

    subgraph CentralBoundary ["Zone 2: AI-Chan Central Server (DMZ / Cloud / Localhost)"]
        ReverseProxy["TLS Ingress / Reverse Proxy"]
        BackendAPI["FastAPI Control Plane (Port 8000)"]
        SQLiteDB[("SQLite Database")]
    end

    subgraph HostBoundary ["Zone 3: Workstation Host (Behind NAT / Firewall)"]
        RunnerProcess["Agent Runner Process"]
        LocalRepo["Git Working Tree"]
        ToolEngines["CLI Runtimes (agy / claude)"]
    end

    %% Network arrows showing outbound initiation
    Browser -->|"1. HTTPS / JWT Auth (Inbound to Backend)"| ReverseProxy
    ReverseProxy --> BackendAPI
    BackendAPI --> SQLiteDB

    %% Crucial security feature: Runner connects OUTBOUND to Backend
    RunnerProcess -->|"2. Outbound HTTPS Long-Poll / SSE<br/>(Bearer Runner Secret Key)"| ReverseProxy
    
    %% Localhost actions
    RunnerProcess -->|"3. Local filesystem access"| LocalRepo
    RunnerProcess -->|"4. Subprocess execution"| ToolEngines
