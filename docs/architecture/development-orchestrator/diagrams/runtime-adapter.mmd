%% ------------------------------------------------------------------------------
%% DIAGRAM 1: Runtime Adapter Component Architecture
%% ------------------------------------------------------------------------------
graph TB
    subgraph RunnerHost ["Agent Runner Daemon (Host Machine)"]
        RunnerClient["Runner Client Service<br/>(Task Lease & Heartbeat)"]
        Supervisor["Process Supervisor & Sandbox Guard"]
        SecurityProfile["Runtime Security Policy<br/>(Containment & Env Scrubbing)"]

        subgraph AdapterLayer ["Runtime Adapter Abstraction"]
            BaseAdapter["<<interface>><br/>BaseRuntimeAdapter"]
            AgyAdapter["AntigravityAdapter<br/>(CLI Driver v1.2.16)"]
            ClaudeAdapter["ClaudeCodeAdapter<br/>(Future Driver v2.1.300)"]
        end

        subgraph StreamPipeline ["Streaming & Normalization"]
            LineBuffer["NDJSON Line Buffer<br/>(2MB Line Limit)"]
            EventNormalizer["Event Normalizer<br/>(Tier 1 -> Tier 2)"]
            Redactor["Secret & Path Redaction Filter<br/>(Tier 2 -> Tier 3)"]
        end
    end

    subgraph NativeOS ["Host Operating System"]
        AgyProcess["Antigravity CLI Subprocess<br/>(agy.exe -p --output-format stream-json)"]
        LocalRepo["Git Working Tree<br/>(Target Repository)"]
    end

    %% Internal Wiring
    RunnerClient -->|"Dispatches TaskSpec"| Supervisor
    Supervisor --> SecurityProfile
    Supervisor --> BaseAdapter
    BaseAdapter <|-- AgyAdapter
    BaseAdapter <|-- ClaudeAdapter

    AgyAdapter -->|"Spawns (asyncio.create_subprocess_exec)"| AgyProcess
    AgyProcess -->|"Reads/writes files"| LocalRepo
    AgyProcess -->|"stdout: NDJSON Chunks"| LineBuffer
    LineBuffer --> EventNormalizer
    EventNormalizer --> Redactor
    Redactor -->|"Dispatches Normalized Events"| RunnerClient

%% ------------------------------------------------------------------------------
%% DIAGRAM 2: End-to-End Execution Sequence
%% ------------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Dev as Developer (Browser UI)
    participant API as Backend Control Plane
    participant Runner as Agent Runner Daemon
    participant Adapter as AntigravityAdapter
    participant CLI as agy.exe (Subprocess)
    participant Repo as Local Workspace (Git)

    Dev->>API: POST /api/v1/orchestrator/tasks (prompt, workspace_id)
    API->>Runner: SSE Task Dispatch (task_id, spec, policy)
    activate Runner
    Runner->>Adapter: start_task(TaskSpec, ExecutionPolicy)
    activate Adapter
    Adapter->>Adapter: Validate path containment (commonpath)
    Adapter->>Adapter: Build safe args: ['agy.exe', '-p', prompt, '--output-format', 'stream-json']
    Adapter->>CLI: Spawn process (creationflags=CREATE_NO_WINDOW)
    deactivate Adapter
    activate CLI

    CLI->>Repo: Inspects files (view_file, list_dir)
    CLI-->>Adapter: stdout: {"event": "init", "tools": [...]}
    Adapter->>Runner: Normalized Event: TASK_INITIALIZED
    Runner->>API: POST /tasks/{id}/events (batch)
    API-->>Dev: SSE Stream: Task Initialized Card

    CLI->>Repo: Edits file (replace_file_content)
    CLI-->>Adapter: stdout: {"event": "step_update", "step_type": "agent_response", "text_delta": "Refactoring..."}
    Adapter->>Runner: Normalized Event: TEXT_DELTA
    Runner->>API: POST /tasks/{id}/events
    API-->>Dev: SSE Stream: Live Text Streaming

    CLI-->>Adapter: stdout: {"event": "result", "status": "SUCCESS", "usage": {"total_tokens": 1420}}
    deactivate CLI
    activate Adapter
    Adapter->>Adapter: Clean process wait() & exit code 0
    Adapter-->>Runner: collect_result() -> TerminalResult(SUCCESS)
    deactivate Adapter
    Runner->>API: POST /tasks/{id}/complete (summary, metrics)
    deactivate Runner
    API-->>Dev: SSE Stream: TASK_COMPLETED (Success Badge & Artifacts)

%% ------------------------------------------------------------------------------
%% DIAGRAM 3: Event Normalization Pipeline (Three Tiers)
%% ------------------------------------------------------------------------------
flowchart LR
    subgraph Tier1 ["Tier 1: Raw Output"]
        RawChunk["Raw stdout / stderr chunks<br/>(Partial bytes & NDJSON)"]
    end

    subgraph NormalizationEngine ["Runner Normalizer Engine"]
        LineSplitter["Line Splitter & 2MB Guard"]
        JSONParser["JSON Deserializer & Error Trap"]
        FieldMapper["Antigravity Event Mapper<br/>(init / step_update / result)"]
    end

    subgraph Tier2 ["Tier 2: Domain Events"]
        DomainEnvelope["AI-Chan Domain Event Envelope<br/>(event_id, task_id, sequence_no)"]
    end

    subgraph RedactionFilter ["Security Redaction Filter"]
        TokenMask["API Key & Token Masker<br/>(Regex: sk-..., ghp-..., Bearer)"]
        PathMask["Home Path Truncator<br/>(C:\\Users\\***\\...)"]
    end

    subgraph Tier3 ["Tier 3: Presentation View"]
        ClientSSE["Frontend Presentation Payload<br/>(Safe SSE Cards & Markdown)"]
    end

    RawChunk --> LineSplitter
    LineSplitter --> JSONParser
    JSONParser --> FieldMapper
    FieldMapper --> DomainEnvelope
    DomainEnvelope --> TokenMask
    TokenMask --> PathMask
    PathMask --> ClientSSE

%% ------------------------------------------------------------------------------
%% DIAGRAM 4: Runtime Process State Machine
%% ------------------------------------------------------------------------------
stateDiagram-v2
    [*] --> READY : Runner Initialized
    READY --> PREPARING : Task Spec Received
    
    PREPARING --> RUNNING : Subprocess Spawned (agy.exe)
    PREPARING --> FAILED : Pre-flight Check Failed (Invalid Path/Binary)
    
    RUNNING --> WAITING_APPROVAL : Approval Requested (Tool Guard)
    WAITING_APPROVAL --> RUNNING : Approval Granted
    WAITING_APPROVAL --> CANCELLED : Approval Rejected
    
    RUNNING --> DRAINING : CLI Emits 'result' Event
    DRAINING --> COMPLETED : Process Exits 0 (Verified Result)
    DRAINING --> FAILED : Process Exits Non-Zero / Result Corrupted
    
    RUNNING --> TIMEOUT : Exceeded 900s Turn Budget
    RUNNING --> CANCELLED : User Cancel Request Received
    RUNNING --> CRASHED : OS Crash / Out of Memory
    
    TIMEOUT --> CLEANING_UP
    CANCELLED --> CLEANING_UP
    FAILED --> CLEANING_UP
    CRASHED --> CLEANING_UP
    COMPLETED --> CLEANING_UP
    
    CLEANING_UP --> READY : Process Tree Killed & Buffers Cleared

%% ------------------------------------------------------------------------------
%% DIAGRAM 5: Timeout and Cancellation Sequence
%% ------------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Dev as Developer (User)
    participant UI as Browser UI
    participant API as Backend Control Plane
    participant Runner as Agent Runner Daemon
    participant Adapter as AntigravityAdapter
    participant Process as agy.exe + Child Tools

    Dev->>UI: Clicks "Cancel Task"
    UI->>API: POST /api/v1/orchestrator/tasks/{id}/cancel
    API->>Runner: SSE Task Cancel Event (run_id)
    activate Runner
    Runner->>Adapter: cancel_task(run_id, reason="User cancelled")
    activate Adapter

    Note over Adapter,Process: Phase 1: Graceful Interrupt (10s Grace Period)
    Adapter->>Process: SIGINT / SIGTERM signal
    
    alt Process Exits Within Grace Period
        Process-->>Adapter: Process terminated cleanly
    else Timeout Elapses (10 seconds)
        Note over Adapter,Process: Phase 2: Forceful Tree Termination
        Adapter->>Process: taskkill /T /F /PID <pid> (Windows) or kill -9 -pgid (POSIX)
        Process-->>Adapter: Entire process tree eradicated
    end

    Adapter->>Adapter: Drain remaining stderr diagnostics
    Adapter-->>Runner: Cleanup finished (exit_status: CANCELLED)
    deactivate Adapter
    Runner->>API: POST /tasks/{id}/events (TASK_CANCELLED)
    deactivate Runner
    API-->>UI: SSE Event: Task Cancelled Confirmation

