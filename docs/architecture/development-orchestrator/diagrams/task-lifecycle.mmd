%% DIAGRAM 7: Domain Model ERD
%% ------------------------------------------------------------------------------
erDiagram
    USERS ||--o{ DEVELOPMENT_TASKS : "owns"
    PROJECTS ||--o{ DEVELOPMENT_TASKS : "initiates"
    DEVELOPMENT_WORKSPACES ||--o{ DEVELOPMENT_TASKS : "targets"
    DEVELOPMENT_TASKS ||--o{ TASK_ATTEMPTS : "has attempts"
    AGENT_RUNNERS ||--o{ TASK_ATTEMPTS : "executes"
    TASK_ATTEMPTS ||--o{ TASK_EVENTS : "emits"
    TASK_ATTEMPTS ||--o{ TASK_ARTIFACTS : "produces"
    TASK_ATTEMPTS ||--o{ TASK_APPROVALS : "records"

    DEVELOPMENT_TASKS {
        string id PK
        string user_id FK
        string project_id FK
        string workspace_id FK
        string title
        text prompt
        string status
        string current_attempt_id FK
    }

    TASK_ATTEMPTS {
        string id PK
        string task_id FK
        int attempt_number
        string runner_id FK
        string runtime
        string status
        int exit_code
        float duration_seconds
        int tokens_in
        int tokens_out
        string git_branch
    }

    TASK_EVENTS {
        string id PK
        string attempt_id FK
        int sequence_number
        string event_type
        string severity
        text payload
    }

    TASK_ARTIFACTS {
        string id PK
        string attempt_id FK
        string artifact_type
        string file_path
        text content
    }

    TASK_APPROVALS {
        string id PK
        string attempt_id FK
        string decision
        text description
        string decided_by FK
    }

%% ------------------------------------------------------------------------------
%% DIAGRAM 8: Swimlane Responsibility Matrix
%% ------------------------------------------------------------------------------
sequenceDiagram
    autonumber
    box rgba(99, 102, 241, 0.1) User & Frontend
        actor User as Developer
        participant UI as AI-Chan Frontend
    end
    box rgba(16, 185, 129, 0.1) Control Plane
        participant API as FastAPI Backend
        participant DB as SQLite DB
    end
    box rgba(245, 158, 11, 0.1) Execution Environment
        participant Runner as Agent Runner
        participant Runtime as agy.exe
    end

    User->>UI: Enters task prompt
    UI->>API: POST /tasks (dispatch=true)
    API->>DB: Save Task (status=QUEUED)
    API->>Runner: Lease dispatch challenge
    Runner->>Runtime: Spawn agy.exe --mode plan
    Runtime-->>Runner: Emit plan NDJSON
    Runner->>API: POST /tasks/{id}/events
    API->>DB: Store events
    API-->>UI: SSE broadcast
    UI-->>User: Display plan for approval
    User->>UI: Clicks "Approve"
    UI->>API: POST /tasks/{id}/approval
    API->>Runner: Transmit approval
    Runner->>Runtime: Continue in accept-edits
    Runtime-->>Runner: Final result & diff
    Runner->>API: POST /tasks/{id}/complete
    API->>DB: Update status=REVIEW_REQUIRED
    API-->>UI: Display diff review modal
    User->>UI: Clicks "Accept Changes"
    UI->>API: POST /tasks/{id}/review (ACCEPT)
    API->>DB: Update status=COMPLETED

%% ------------------------------------------------------------------------------
%% DIAGRAM 9: Operational Failure Recovery Flow
%% ------------------------------------------------------------------------------
flowchart TD
    HeartbeatLost[Runner Misses Heartbeats for 60s] --> MarkOffline[Backend marks Runner OFFLINE]
    MarkOffline --> SuspendTask[Active Task marked SUSPENDED_OFFLINE]
    SuspendTask --> StartTimer[Start 10-Minute Recovery Window]
    
    StartTimer --> ReconnectCheck{Did Runner reconnect<br/>within 10 minutes?}
    ReconnectCheck -- Yes --> QueryHost[Runner checks if agy.exe PID is still alive]
    QueryHost --> IsAlive{Process Alive?}
    IsAlive -- Yes --> ResumeStream[Resume SSE streaming to UI<br/>Task back to RUNNING]
    IsAlive -- No --> ReportCrash[Runner reports PROCESS_DIED] --> MarkFailed[Task marked FAILED<br/>error: INTERRUPTED]

    ReconnectCheck -- No --> TimeoutExpire[10 Minutes Elapsed]
    TimeoutExpire --> TerminateLease[Revoke Runner lease]
    TerminateLease --> MarkFailed

