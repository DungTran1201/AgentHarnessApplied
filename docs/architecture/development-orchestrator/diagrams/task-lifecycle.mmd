%% ------------------------------------------------------------------------------
%% DIAGRAM 1: Development Task Complete State Machine
%% ------------------------------------------------------------------------------
stateDiagram-v2
    [*] --> DRAFT : User Creates Task
    DRAFT --> QUEUED : User Dispatches Task
    DRAFT --> CANCELLED : User Discards Draft

    QUEUED --> DISPATCHING : Runner Claims Lease
    QUEUED --> BLOCKED : Runner Offline / Dirty Repo
    BLOCKED --> QUEUED : Pre-flight Resolved

    DISPATCHING --> PLANNING : Subprocess Spawned (--mode plan)
    DISPATCHING --> BLOCKED : Host Environment Check Failed

    PLANNING --> AWAITING_APPROVAL : Plan Produced by Agent
    PLANNING --> FAILED : Agent Crashed / Syntax Error
    PLANNING --> TIMED_OUT : Exceeded 900s Turn Budget
    PLANNING --> CANCELLING : User Cancels

    AWAITING_APPROVAL --> RUNNING : User Approves Plan
    AWAITING_APPROVAL --> CANCELLED : User Rejects Plan
    AWAITING_APPROVAL --> TIMED_OUT : 24h Approval Timeout

    RUNNING --> AWAITING_APPROVAL : Destructive Tool Intercepted
    RUNNING --> VERIFYING : Process Exits 0 & Terminal Result Received
    RUNNING --> FAILED : Process Non-Zero / Error
    RUNNING --> TIMED_OUT : Exceeded 900s Turn Budget
    RUNNING --> CANCELLING : User Cancels

    CANCELLING --> CANCELLED : Process Kill Acknowledged

    VERIFYING --> REVIEW_REQUIRED : Verification Complete & Redacted Diff Generated
    VERIFYING --> FAILED : Fatal Verification Pipeline Crash

    REVIEW_REQUIRED --> COMPLETED : User Approves (APPROVE / ACCEPT)
    REVIEW_REQUIRED --> QUEUED : User Requests Changes (Follow-up Attempt Spawned)
    REVIEW_REQUIRED --> FAILED : User Rejects Changes (REJECT)
    REVIEW_REQUIRED --> CANCELLED : User Cancels Task

    COMPLETED --> [*]
    FAILED --> [*]
    CANCELLED --> [*]

%% ------------------------------------------------------------------------------
%% DIAGRAM 2: Sequence: Create Task from Project Chat
%% ------------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Dev as Developer (User)
    participant ChatUI as FloatingProjectChat.tsx
    participant Modal as CreateTaskModal.tsx
    participant API as Backend API (/api/v1/orchestrator)
    participant DB as SQLite (app.db)

    Dev->>ChatUI: Asks conversational question
    ChatUI-->>Dev: Assistant suggests code refactoring
    Dev->>ChatUI: Clicks "Convert to Development Task"
    ChatUI->>Modal: Opens with pre-filled title, prompt, and workspace_id
    Dev->>Modal: Selects Runtime (Antigravity) and clicks "Create & Dispatch"
    Modal->>API: POST /orchestrator/tasks (prompt, workspace_id, auto_dispatch=true)
    activate API
    API->>DB: INSERT INTO development_tasks (status='QUEUED', idempotency_key=...)
    API->>DB: INSERT INTO task_attempts (attempt_number=1, status='QUEUED')
    API-->>Modal: 201 Created (task_id, attempt_id)
    deactivate API
    Modal-->>ChatUI: Closes modal & navigates
    ChatUI-->>Dev: Redirects to /tasks/{id} (Task Console)

%% ------------------------------------------------------------------------------
%% DIAGRAM 3: Sequence: Dispatch and Stream Events
%% ------------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Dev as Developer
    participant ConsoleUI as TaskConsole.tsx (Next.js)
    participant API as Backend Control Plane
    participant Runner as Local Agent Runner
    participant AgyCLI as Antigravity CLI (agy.exe)

    Dev->>ConsoleUI: Connects to /tasks/{id}/events (SSE)
    activate ConsoleUI
    ConsoleUI->>API: GET /tasks/{id}/events (Accept: text/event-stream)
    activate API
    API-->>ConsoleUI: HTTP 200 OK (Connection established)

    %% Dispatch to Runner
    API->>Runner: SSE Dispatch Event: task_dispatched(spec, policy)
    activate Runner
    Runner->>Runner: Verify git branch (ai-chan/task-01J9X8)
    Runner->>AgyCLI: Spawn agy.exe -p ... --output-format stream-json
    activate AgyCLI

    loop NDJSON Streaming
        AgyCLI-->>Runner: stdout: {"event": "step_update", "text_delta": "..."}
        Runner->>API: POST /tasks/{id}/events (batch of normalized events)
        API-->>ConsoleUI: SSE Event: TEXT_DELTA (Markdown text chunk)
        ConsoleUI-->>Dev: Appends text in live transcript
    end

    AgyCLI-->>Runner: stdout: {"event": "result", "status": "SUCCESS"}
    deactivate AgyCLI
    Runner->>API: POST /tasks/{id}/complete (TerminalResult)
    deactivate Runner
    API-->>ConsoleUI: SSE Event: TASK_COMPLETED
    deactivate API
    deactivate ConsoleUI

%% ------------------------------------------------------------------------------
%% DIAGRAM 4: Sequence: Plan Approval & Interception
%% ------------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Dev as Developer
    participant UI as TaskConsole (Approval Modal)
    participant API as Backend Control Plane
    participant DB as SQLite (app.db)
    participant Runner as Local Agent Runner

    Note over Runner: Agent produces structured plan in --mode plan
    Runner->>API: POST /tasks/{id}/events (APPROVAL_REQUIRED, payload={plan})
    activate API
    API->>DB: UPDATE development_tasks SET status='AWAITING_APPROVAL'
    API-->>UI: SSE Event: APPROVAL_REQUIRED (Structured Plan)
    deactivate API
    UI-->>Dev: Displays "Action Plan Awaiting Approval" Modal

    Dev->>UI: Reviews step list & clicks "Approve Plan"
    UI->>API: POST /tasks/{id}/approval (decision="APPROVED")
    activate API
    API->>DB: INSERT INTO task_approvals (decision='APPROVED', decided_by=user_id)
    API->>DB: UPDATE development_tasks SET status='RUNNING'
    API->>Runner: SSE Signal: approval_decision(decision="APPROVED")
    deactivate API
    activate Runner
    Runner->>Runner: Switches runtime to --mode accept-edits
    Runner-->>UI: SSE Event: TASK_EXECUTION_RESUMED
    deactivate Runner
    UI-->>Dev: Modal closes; running progress indicator active

%% ------------------------------------------------------------------------------
%% DIAGRAM 5: Sequence: Cancel Task with Termination Acknowledgment
%% ------------------------------------------------------------------------------
sequenceDiagram
    autonumber
    actor Dev as Developer
    participant UI as TaskConsole UI
    participant API as Backend Control Plane
    participant DB as SQLite (app.db)
    participant Runner as Local Agent Runner
    participant OS as Host OS Process Supervisor

    Dev->>UI: Clicks "Cancel Task"
    UI->>API: POST /tasks/{id}/cancel (reason="User requested cancel")
    activate API
    API->>DB: UPDATE development_tasks SET status='CANCELLING'
    API->>Runner: SSE Task Cancel Request (run_id)
    API-->>UI: 202 Accepted (status: CANCELLING)
    deactivate API
    UI-->>Dev: Button changes to "Aborting... (Waiting for process kill)"

    activate Runner
    Runner->>OS: Send SIGINT / SIGTERM to agy.exe
    Note over OS: Waits 10s grace period...
    OS->>OS: Process still running -> taskkill /T /F /PID <pid>
    OS-->>Runner: Process tree eradicated
    Runner->>API: POST /tasks/{id}/events (TASK_CANCELLED, acknowledged=true)
    deactivate Runner
    activate API
    API->>DB: UPDATE development_tasks SET status='CANCELLED'
    API-->>UI: SSE Event: TASK_CANCELLED (Terminal)
    deactivate API
    UI-->>Dev: Badge turns Red [CANCELLED]; UI enables "Start New Task"

%% ------------------------------------------------------------------------------
%% DIAGRAM 6: Activity Flow from User Request to Review
%% ------------------------------------------------------------------------------
flowchart TD
    Start([User Request in Chat]) --> IntentCheck{Is coding task<br/>requested?}
    IntentCheck -- No --> AnswerChat[Regular LLM Conversational Answer] --> End([Done])
    IntentCheck -- Yes --> ConvertTask[Click 'Convert to Task']
    ConvertTask --> PreFlight{Pre-flight Check:<br/>Workspace Ready & Runner Online?}
    PreFlight -- No --> ShowBlocked[Mark BLOCKED<br/>Display error in UI] --> FixEnv[Developer fixes environment] --> PreFlight
    PreFlight -- Yes --> DispatchPlan[Dispatch Task in mode: plan]
    
    DispatchPlan --> StreamPlan[Agent Streams Discovery & Plan]
    StreamPlan --> ApprovalNeeded{Does plan require<br/>human approval?}
    ApprovalNeeded -- Yes --> WaitApproval[Pause at AWAITING_APPROVAL<br/>Show Approval Modal]
    WaitApproval --> Decision{User Decision?}
    Decision -- Reject --> CancelTask[Abort Task & Revert] --> End
    Decision -- Approve --> RunEdits[Execute in mode: accept-edits]
    ApprovalNeeded -- No --> RunEdits

    RunEdits --> VerifyDiff[Generate Unified Git Diff & Run Tests]
    VerifyDiff --> DiffPass{Tests & Diff Valid?}
    DiffPass -- No --> MarkFailed[Mark FAILED<br/>Display error diagnostic] --> End
    DiffPass -- Yes --> ReviewScreen[Present REVIEW_REQUIRED Screen]
    ReviewScreen --> FinalDecision{Developer Review?}
    FinalDecision -- Reject --> RevertChanges[Revert task branch] --> End
    FinalDecision -- Accept --> MergeBranch[Commit to target branch] --> Complete[Mark COMPLETED] --> End

